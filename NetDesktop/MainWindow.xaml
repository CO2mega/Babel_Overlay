<Window x:Class="NetDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="字幕翻译"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        Left="200" Top="800" Height="120" Width="520"
        MinWidth="260" MinHeight="60"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B9BD5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Input style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>

        <!-- ComboBox item style (dark) -->
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style (dark) -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bd" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>
                            <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ToggleBtn" Grid.ColumnSpan="2"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path x:Name="Arrow" Grid.Column="1" Fill="#AAAAAA"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1E1E2E" BorderBrush="#44FFFFFF" BorderThickness="1"
                                        CornerRadius="2" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B9BD5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A85BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="10" Background="#CC0D0D1A"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR ===== -->
            <Grid x:Name="NavSidebar" Grid.Column="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar / drag area -->
                <Border Grid.Row="0" Padding="16,14,16,10"
                        MouseLeftButtonDown="Border_MouseLeftButtonDown">
                    <TextBlock Text="字幕翻译" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                </Border>

                <!-- Nav items -->
                <ListBox x:Name="NavList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="0">实时字幕</ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="1">历史记录</ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="2">设置</ListBoxItem>
                </ListBox>

                <!-- Collapse button -->
                <Button Grid.Row="2" Content="收起 ←" Style="{StaticResource IconButton}"
                        Margin="10,0,10,12" HorizontalAlignment="Left"
                        Click="CollapseNav_Click"/>
            </Grid>

            <!-- Sidebar separator -->
            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                       Fill="#22FFFFFF" Visibility="{Binding Visibility, ElementName=NavSidebar}"/>

            <!-- ===== CONTENT AREA ===== -->
            <Grid x:Name="ContentArea" Grid.Column="1">

                <!-- PAGE 1: Overlay / Live Subtitles -->
                <Grid x:Name="PageOverlay" Visibility="Visible" Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status row with expand button -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="StatusText" Text="启动中..."
                                   Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="ExpandNavBtn" Content="☰" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="展开导航" Click="ExpandNav_Click"/>
                    </Grid>

                    <!-- Original text -->
                    <TextBlock x:Name="OriginalText" Grid.Row="1"
                               Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,2"/>

                    <!-- Translated text -->
                    <TextBlock x:Name="TranslatedText" Grid.Row="2"
                               Foreground="#FFD700" FontSize="14"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>

                <!-- PAGE 2: History -->
                <Grid x:Name="PageHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="历史记录"
                               Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                               Margin="16,12,16,8"/>

                    <ListView x:Name="HistoryList" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#FFFFFF" Margin="8,0,8,8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding OriginalText}"
                                               Foreground="#FFFFFF" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="{Binding TranslatedText}"
                                               Foreground="#FFD700" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                               Foreground="#555555" FontSize="10" Margin="0,3,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- PAGE 3: Settings -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置"
                               Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                               Margin="16,12,16,4"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="16,0">
                        <StackPanel Margin="0,0,8,8">

                            <!-- TRANSLATION SECTION -->
                            <TextBlock Text="翻译" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="翻译引擎" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbEngine" Style="{StaticResource ComboStyle}" Margin="0,0,0,10"
                                      SelectionChanged="CbEngine_SelectionChanged">
                                <ComboBoxItem>Google</ComboBoxItem>
                                <ComboBoxItem>DeepL</ComboBoxItem>
                            </ComboBox>

                            <!-- Google fields -->
                            <StackPanel x:Name="GoogleKeyPanel">
                                <TextBlock Text="Google API Key（留空使用默认）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbGoogleKey" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- DeepL fields -->
                            <StackPanel x:Name="DeepLPanel" Visibility="Collapsed">
                                <TextBlock Text="DeepL API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbDeepLKey" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="DeepL 服务器地址" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbDeepLUrl" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>
                            </StackPanel>

                            <TextBlock Text="目标语言（如 zh / ja / ko）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbTargetLang" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <!-- APPEARANCE SECTION -->
                            <TextBlock Text="外观" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlOpacity" Grid.Column="0" Minimum="0.1" Maximum="1.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblOpacity" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="字号" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlFontSize" Grid.Column="0" Minimum="10" Maximum="32"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblFontSize" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="字重" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbFontWeight" Style="{StaticResource ComboStyle}" Margin="0,0,0,10">
                                <ComboBoxItem>Normal</ComboBoxItem>
                                <ComboBoxItem>Medium</ComboBoxItem>
                                <ComboBoxItem>SemiBold</ComboBoxItem>
                                <ComboBoxItem>Bold</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Text="原文颜色（十六进制）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbSubtitleColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectSubtitleColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="译文颜色（十六进制）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTranslationColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectTranslationColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="背景颜色（十六进制，含透明度 #AARRGGBB）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbBackgroundColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectBackgroundColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ENDPOINT SECTION -->
                            <TextBlock Text="端点检测" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="静音结束阈值（秒）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlTrailingSilence" Grid.Column="0" Minimum="0.5" Maximum="5.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblTrailingSilence" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="最短语音长度（秒）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlUtteranceLength" Grid.Column="0" Minimum="0.1" Maximum="5.0"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblUtteranceLength" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="保存" Style="{StaticResource ActionButton}"
                            Margin="16,8" HorizontalAlignment="Right"
                            Click="SaveSettings_Click"/>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
