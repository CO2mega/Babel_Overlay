<Window x:Class="NetDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="字幕翻译"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        Left="200" Top="800" Height="240" Width="520"
        MinWidth="260" MinHeight="60"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Input style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>

        <!-- Button style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#5B9BD5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A85BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="10" Background="#0D0D1A"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== SIDEBAR: NavigationView ===== -->
            <ui:NavigationView x:Name="NavSidebar" Grid.Column="0"
                               IsBackButtonVisible="Collapsed"
                               OpenPaneLength="180"
                               CompactPaneLength="48"
                               IsPaneOpen="False"
                               PaneDisplayMode="Left"
                               Background="Transparent">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="实时字幕" Tag="0" Click="NavItemClick">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ChatSparkle16"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Content="历史记录" Tag="1" Click="NavItemClick">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History20"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="设置" Tag="2" Click="NavItemClick">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24"/>
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Sidebar separator -->
            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                       Fill="#22FFFFFF"/>

            <!-- ===== CONTENT AREA ===== -->
            <Grid x:Name="ContentArea" Grid.Column="1">

                <!-- PAGE 1: Overlay / Live Subtitles -->
                <Grid x:Name="PageOverlay" Visibility="Visible" Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status row -->
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="StatusText" Text="启动中..."
                                   Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Original text -->
                    <TextBlock x:Name="OriginalText" Grid.Row="1"
                               Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,2"/>

                    <!-- Translated text -->
                    <TextBlock x:Name="TranslatedText" Grid.Row="2"
                               Foreground="#FFD700" FontSize="14"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,2,0,0"/>

                    <!-- History cards -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <ItemsControl x:Name="HistoryCards" ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="4"
                                            Background="#18FFFFFF">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding OriginalText}"
                                                       Foreground="#CCCCCC" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="{Binding TranslatedText}"
                                                       Foreground="#FFD700" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 2: History -->
                <Grid x:Name="PageHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="历史记录"
                               Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                               Margin="16,12,16,8"/>

                    <ListView x:Name="HistoryList" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#FFFFFF" Margin="8,0,8,8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding OriginalText}"
                                               Foreground="#FFFFFF" FontSize="13"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="{Binding TranslatedText}"
                                               Foreground="#FFD700" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                               Foreground="#555555" FontSize="10" Margin="0,3,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- PAGE 3: Settings -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="设置"
                               Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                               Margin="16,12,16,4"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="16,0">
                        <StackPanel Margin="0,0,8,8">

                            <!-- LIVE CAPTIONS SECTION -->
                            <TextBlock Text="Live Captions" Style="{StaticResource SectionHeader}"/>
                            <Button Content="打开 Live Captions 设置（语言/麦克风）"
                                    Style="{StaticResource ActionButton}" Margin="0,0,0,10"
                                    Click="LiveCaptionsSettings_Click"/>

                            <!-- TRANSLATION SECTION -->
                            <TextBlock Text="翻译" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="翻译引擎" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbEngine" Margin="0,0,0,10"
                                      SelectionChanged="CbEngine_SelectionChanged">
                                <ComboBoxItem>Google</ComboBoxItem>
                                <ComboBoxItem>Google2（免费）</ComboBoxItem>
                                <ComboBoxItem>DeepL</ComboBoxItem>
                                <ComboBoxItem>OpenAI 兼容</ComboBoxItem>
                            </ComboBox>

                            <!-- Google fields -->
                            <StackPanel x:Name="GoogleKeyPanel">
                                <TextBlock Text="Google API Key（留空使用默认）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbGoogleKey" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- DeepL fields -->
                            <StackPanel x:Name="DeepLPanel" Visibility="Collapsed">
                                <TextBlock Text="DeepL API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbDeepLKey" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="DeepL 服务器地址" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbDeepLUrl" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- OpenAI fields -->
                            <StackPanel x:Name="OpenAIPanel" Visibility="Collapsed">
                                <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbOpenAIUrl" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbOpenAIKey" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>

                                <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TbOpenAIModel" Style="{StaticResource InputBox}"
                                         Margin="0,0,0,10"/>
                            </StackPanel>

                            <TextBlock Text="目标语言（如 zh / ja / ko）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbTargetLang" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <!-- ADVANCED TRANSLATION SETTINGS -->
                            <TextBlock Text="高级翻译设置" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="请求超时（秒）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbTimeoutSeconds" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="失败重试次数" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbMaxRetry" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="重试间隔（毫秒）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbRetryDelayMs" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="节流延迟（毫秒）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbThrottleDelayMs" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="上下文窗口大小" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TbContextWindowSize" Style="{StaticResource InputBox}"
                                     Margin="0,0,0,10"/>

                            <!-- APPEARANCE SECTION -->
                            <TextBlock Text="外观" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="背景不透明度" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlOpacity" Grid.Column="0" Minimum="0.1" Maximum="1.0"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblOpacity" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="字号" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SlFontSize" Grid.Column="0" Minimum="10" Maximum="32"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblFontSize" Grid.Column="1"
                                           Foreground="#AAAAAA" FontSize="11"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <TextBlock Text="字重" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CbFontWeight" Margin="0,0,0,10">
                                <ComboBoxItem>Normal</ComboBoxItem>
                                <ComboBoxItem>Medium</ComboBoxItem>
                                <ComboBoxItem>SemiBold</ComboBoxItem>
                                <ComboBoxItem>Bold</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Text="原文颜色（十六进制）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbSubtitleColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectSubtitleColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="译文颜色（十六进制）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTranslationColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectTranslationColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="背景颜色（十六进制）" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbBackgroundColor" Grid.Column="0"
                                         Style="{StaticResource InputBox}" Margin="0,0,6,0"
                                         TextChanged="ColorBox_TextChanged"/>
                                <Rectangle x:Name="RectBackgroundColor" Grid.Column="1"
                                           Width="22" Height="22" RadiusX="3" RadiusY="3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="保存" Style="{StaticResource ActionButton}"
                            Margin="16,8" HorizontalAlignment="Right"
                            Click="SaveSettings_Click"/>
                </Grid>

                <!-- Close button -->
                <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,8,0" Background="Transparent" BorderThickness="0"
                        Foreground="#888888" FontSize="13" Padding="4,2" Cursor="Hand"
                        ToolTip="关闭" Click="CloseBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#44FF4444"/>
                                                <Setter Property="Foreground" Value="#FF6666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
